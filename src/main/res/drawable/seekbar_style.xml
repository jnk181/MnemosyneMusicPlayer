<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@android:id/background"
        android:gravity="center_vertical"
        android:height="18dp">
        <nine-patch
            android:src="@drawable/seekbar_bk_small3"
            android:dither="true" />
    </item>

    <item
        android:id="@android:id/progress"
        android:gravity="center_vertical"
        android:height="18dp">
        <clip>
            <nine-patch
                android:src="@drawable/seekbar_bk_small3_green"
                android:dither="true" />
        </clip>
    </item>

</layer-list>