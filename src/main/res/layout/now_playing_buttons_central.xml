<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/npActionButtonsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="horizontal">

    <android.widget.ImageButton
        android:id="@+id/npBtnStop"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Stop Playback"
        android:scaleType="centerInside"
        android:src="@drawable/playback_stop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/npBtnPrev"
        app:layout_constraintTop_toTopOf="parent" />

    <android.widget.ImageButton
        android:id="@+id/npBtnPrev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Previous Track"
        android:scaleType="centerInside"
        android:src="@drawable/playback_prev"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/npBtnPlayPause"
        app:layout_constraintTop_toTopOf="parent" />

    <android.widget.ImageButton
        android:id="@+id/npBtnNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next Track"
        android:scaleType="centerInside"
        android:src="@drawable/playback_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/npBtnPlayPause"
        app:layout_constraintTop_toTopOf="parent" />

    <android.widget.ImageButton
        android:id="@+id/npBtnPlayPause"
        android:layout_width="100dp"
        android:layout_height="56dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play or Pause Track"
        android:scaleType="centerInside"
        android:src="@drawable/button_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <android.widget.ImageView
        android:id="@+id/npIvVolumeStatus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Volume Indicator"
        android:scaleType="fitCenter"
        android:src="@drawable/sound"
        android:visibility="gone" />

    <android.widget.SeekBar
        android:id="@+id/npVolumeSeekBar"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:max="100"
        android:progress="75"
        android:progressDrawable="@color/black"
        android:thumb="@color/white"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>