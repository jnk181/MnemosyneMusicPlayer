<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A12">

    <FrameLayout
        android:id="@+id/npEmptyViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/npControlDeckPanel"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/npControlDeckPanel"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@drawable/bottom_bk"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/npSeekBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            tools2:layout_editor_absoluteX="12dp">

            <TextView
                android:id="@+id/npTextTimeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:58"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />

            <android.widget.SeekBar
                android:id="@+id/npPlaybackSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="22"
                android:progressDrawable="@drawable/seekbar_style"
                android:splitTrack="false"
                android:thumb="@drawable/seek_ball" />

            <TextView
                android:id="@+id/npTextTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="4:58"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/npButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/now_playing_buttons_central" />

        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>